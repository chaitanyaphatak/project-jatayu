# ==============================================================================
# SkySense AI / WeatherGPT - Master Environment Configuration Template
# ==============================================================================
# Copy this file to .env in your root, backend/, and frontend/ as needed:
#   cp .env.example .env
#   cp .env.example backend/.env
#   cp .env.example frontend/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION (Backend)
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (Clerk)
# ------------------------------------------------------------------------------
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_PEM_PUBLIC_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# ------------------------------------------------------------------------------
# 3. WEATHER TELEMETRY & SATELLITE RADAR APIS
# ------------------------------------------------------------------------------
# Open-Meteo requires no API key (ECMWF & GFS NWP models)
# OpenWeatherMap API Key (Current Weather & 5-Day Forecast):
OPENWEATHER_API_KEY=
# WeatherAPI.com Key (Real-time telemetry):
WEATHERAPI_COM_KEY=
# IndianAPI.in Key (IMD & Pan-India observation grid):
INDIANAPI_KEY=
# Set to true to allow fallback values when all external APIs are unreachable
USE_MOCK_FALLBACK=true

# ------------------------------------------------------------------------------
# 4. LLM & AI PROVIDERS (Vayu Copilot & Reasoning)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 5. DATABASE & PERSISTENCE (Supabase)
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 6. HUGGING FACE (Vision AI, Crop Disease Diagnosis & Voice STT)
# ------------------------------------------------------------------------------
HUGGINGFACE_API_TOKEN=

# ------------------------------------------------------------------------------
# 7. MAPS & GEO-SPATIAL RADAR (Mapbox)
# ------------------------------------------------------------------------------
MAPBOX_ACCESS_TOKEN=
VITE_MAPBOX_TOKEN=
VITE_API_BASE_URL=/api/v1
